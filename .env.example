# Local development placeholders only. Copy to .env and adjust if needed.
# Do not commit a real .env file.

# ---------------------------------------------------------------------
# PostgreSQL (docker-compose + JDBC de la aplicacion)
# ---------------------------------------------------------------------
POSTGRES_DB=superfercho
POSTGRES_USER=superfercho
POSTGRES_PASSWORD=superfercho
POSTGRES_PORT=5432

SUPERFERCHO_DB_URL=jdbc:postgresql://localhost:5432/superfercho
SUPERFERCHO_DB_USERNAME=superfercho
SUPERFERCHO_DB_PASSWORD=superfercho

# ---------------------------------------------------------------------
# JWT (obligatorio para arrancar; sin default)
# scripts/dev.ps1 genera un secreto local en .env (no versionado).
# ---------------------------------------------------------------------
SUPERFERCHO_JWT_SECRET=

# ---------------------------------------------------------------------
# Fercho AI local (Ollama) — opcion recomendada, 100% local y gratuita.
#
# scripts/setup-fercho.ps1 / setup-fercho.sh:
#   - descarga qwen2.5:7b-instruct (Qwen2.5 7B Instruct) en Ollama;
#   - crea el modelo derivado "fercho-qwen" con num_ctx 16384;
#   - escribe estos valores en .env (solo si estan vacios, con backup previo):
#       SUPERFERCHO_OPENAI_CHAT_URL=http://localhost:11434/v1/chat/completions
#       SUPERFERCHO_OPENAI_CHAT_MODEL=fercho-qwen
#       OPENAI_API_KEY=ollama
#       SUPERFERCHO_OPENAI_CHAT_READ_TIMEOUT=300s
#
# OPENAI_API_KEY=ollama es un valor DUMMY local requerido por el adapter
# actual: los endpoints de Ollama lo ignoran. NO es una credencial de
# OpenAI, no da acceso a ninguna cuenta y no genera cobros.
# ---------------------------------------------------------------------
OPENAI_API_KEY=
SUPERFERCHO_OPENAI_CHAT_URL=
SUPERFERCHO_OPENAI_CHAT_MODEL=
SUPERFERCHO_OPENAI_CHAT_CONNECT_TIMEOUT=5s
SUPERFERCHO_OPENAI_CHAT_READ_TIMEOUT=60s
SUPERFERCHO_OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings

# ---------------------------------------------------------------------
# Proveedor cloud OPCIONAL compatible con Chat Completions.
#
# Si prefieres un proveedor remoto (OpenAI, Z.AI u otro endpoint compatible),
# pon en tu .env TU propia base URL y TU propia API key. El repositorio NO
# provee API keys. Con OPENAI_API_KEY vacio la app funciona igual, sin Fercho
# AI. Nunca commitees tu .env.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Open Food Facts barcode lookup (read-only). User-Agent must identify the app.
# ---------------------------------------------------------------------
SUPERFERCHO_OFF_BASE_URL=https://world.openfoodfacts.org
SUPERFERCHO_OFF_USER_AGENT=SuperFercho/0.1 (https://github.com/FerchoRemolina/SuperFercho)

# ---------------------------------------------------------------------
# Servidor HTTP
# ---------------------------------------------------------------------
SERVER_PORT=8080

# ---------------------------------------------------------------------
# ADMIN local de desarrollo (solo Spring profile `local`).
# Vacios = no se crea. Copia a .env y define tus propios valores.
# Nunca commitees credenciales reales.
# ---------------------------------------------------------------------
SUPERFERCHO_DEV_ADMIN_EMAIL=
SUPERFERCHO_DEV_ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# Email: console logs recovery links locally. Use noop or a real provider
# adapter in production — never console.
# ---------------------------------------------------------------------
SUPERFERCHO_EMAIL_PROVIDER=console
SUPERFERCHO_EMAIL_RECOVERY_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Password recovery (defaults match product rules)
# ---------------------------------------------------------------------
SUPERFERCHO_PASSWORD_RECOVERY_TOKEN_TTL=15m
SUPERFERCHO_PASSWORD_RECOVERY_MAX_REQUESTS=2
SUPERFERCHO_PASSWORD_RECOVERY_REQUEST_WINDOW=24h
SUPERFERCHO_PASSWORD_RECOVERY_IP_MAX_REQUESTS=20
SUPERFERCHO_PASSWORD_RECOVERY_IP_WINDOW=1h
