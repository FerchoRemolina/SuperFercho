# Local development placeholders only. Copy to .env and adjust if needed.
# Do not commit a real .env file.

POSTGRES_DB=superfercho
POSTGRES_USER=superfercho
POSTGRES_PASSWORD=superfercho
POSTGRES_PORT=5432

SUPERFERCHO_DB_URL=jdbc:postgresql://localhost:5432/superfercho
SUPERFERCHO_DB_USERNAME=superfercho
SUPERFERCHO_DB_PASSWORD=superfercho

# Empty in this template. scripts/dev.ps1 generates a local secret into .env (not committed).
SUPERFERCHO_JWT_SECRET=
OPENAI_API_KEY=
SUPERFERCHO_OPENAI_CHAT_URL=
SUPERFERCHO_OPENAI_CHAT_MODEL=
SUPERFERCHO_OPENAI_CHAT_CONNECT_TIMEOUT=5s
SUPERFERCHO_OPENAI_CHAT_READ_TIMEOUT=60s

# Open Food Facts barcode lookup (read-only). User-Agent must identify the app.
SUPERFERCHO_OFF_BASE_URL=https://world.openfoodfacts.org
SUPERFERCHO_OFF_USER_AGENT=SuperFercho/0.1 (https://github.com/FerchoRemolina/SuperFercho)

SERVER_PORT=8080

# Local development ADMIN bootstrap. Used only with Spring profile `local`.
# Leave empty to skip. Copy to .env and set your own values. Do not commit real credentials.
SUPERFERCHO_DEV_ADMIN_EMAIL=
SUPERFERCHO_DEV_ADMIN_PASSWORD=

# Local demo catalog + knowledge seed (profile `local` only). Set to false to skip.
SUPERFERCHO_DEV_DEMO_SEED=true

# Email: console logs recovery links locally. Use noop or a real provider adapter in production — never console.
SUPERFERCHO_EMAIL_PROVIDER=console
SUPERFERCHO_EMAIL_RECOVERY_BASE_URL=http://localhost:3000

# Password recovery (defaults match product rules)
SUPERFERCHO_PASSWORD_RECOVERY_TOKEN_TTL=15m
SUPERFERCHO_PASSWORD_RECOVERY_MAX_REQUESTS=2
SUPERFERCHO_PASSWORD_RECOVERY_REQUEST_WINDOW=24h
SUPERFERCHO_PASSWORD_RECOVERY_IP_MAX_REQUESTS=20
SUPERFERCHO_PASSWORD_RECOVERY_IP_WINDOW=1h
